{
  "buildCommand": "cd vianet && npm ci && npm run build",
  "installCommand": "npm install",
  "functions": {
    "api/index.ts": {
      "includeFiles": "vianet/dist/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/api"
    }
  ]
}
